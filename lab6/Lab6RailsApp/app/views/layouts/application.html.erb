<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "RealEstate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="RealEstate">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <header class="sticky-top">
      <nav class="navbar navbar-expand-xl navbar-dark bg-dark">
        <div class="container">
          <%= link_to "RealEstate", properties_path, class: "navbar-brand" %>

          <button class="navbar-toggler" type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#navbarMenu"
                  aria-controls="navbarMenu"
                  aria-expanded="false"
                  aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarMenu">
            <ul class="navbar-nav me-auto">
              <li class="nav-item">
                <%= link_to "Купівля", properties_buy_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Оренда", properties_rent_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Добово", properties_daily_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Про проєкт", about_path, class: "nav-link" %>
              </li>

              <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                  Керування
                </button>

                <ul class="dropdown-menu">
                  <li>
                    <%= link_to "Створити нерухомість",
                      new_property_path,
                      class: "dropdown-item" %>
                  </li>

                  <li>
                    <%= link_to "Усі об'єкти",
                      properties_path,
                      class: "dropdown-item" %>
                  </li>

                  <li><hr class="dropdown-divider"></li>

                  <li>
                    <%= button_to "Видалити всі",
                      destroy_all_properties_path,
                      method: :delete,
                      class: "dropdown-item text-danger",
                      form: {
                        data: {
                          turbo_confirm: "Ви впевнені, що хочете видалити всі об'єкти нерухомості?"
                        }
                      } %>
                  </li>
                </ul>
              </li>
            </ul>

            <%= form_with url: properties_path,
                          method: :get,
                          local: true,
                          class: "d-flex align-items-center gap-2 mt-3 mt-lg-0" do |form| %>

              <%= form.number_field :min_price,
                value: params[:min_price],
                class: "form-control",
                placeholder: "Від, грн",
                min: 0,
                aria: { label: "Мінімальна ціна" } %>

              <%= form.number_field :max_price,
                value: params[:max_price],
                class: "form-control",
                placeholder: "До, грн",
                min: 0,
                aria: { label: "Максимальна ціна" } %>

              <%= form.submit "Знайти", class: "btn btn-outline-light" %>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <footer class="bg-dark text-light py-4 mt-auto">
      <div class="container text-center">
        <p class="mb-2">RealEstate — агентство нерухомості</p>

        <p class="small mb-2 mx-auto" style="max-width: 900px;">
          Юридичне застереження: інформація на сайті має ознайомчий характер.
          Умови купівлі та оренди уточнюйте у власників нерухомості.
          Адміністрація сайту не несе відповідальності за достовірність
          інформації, наданої користувачами.
        </p>

        <p class="small mb-0">
          Контакт розробника: yaroslava-ivanna.zorii.24@pnu.edu.ua
        </p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>