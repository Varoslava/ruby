<% if properties.any? %>
  <div class="row">
    <% properties.each do |property| %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title"><%= property.title %></h5>

            <p class="card-text"><%= property.description %></p>

            <p>
              <strong>Ціна:</strong>
              <%= number_to_currency(property.price, unit: "грн", format: "%n %u") %>
            </p>

            <%= link_to "Детальніше", property_path(property),
              class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    У цій категорії поки що немає об'єктів нерухомості.
  </div>
<% end %>